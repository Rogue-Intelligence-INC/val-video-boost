# val-video-boost environment configuration
# Copy to .env or export in your shell. All optional; defaults are repo-relative
# or sensible for most setups.

# ============================================================================
# Model Storage
# ============================================================================
# Root directory containing model weights. Defaults to ./models relative to repo.
# Set this to your existing model library to avoid duplicating large files.
VAL_MODELS_ROOT=C:\Ai\models

# ============================================================================
# Valhalla Engine (External Dependency)
# ============================================================================
# The Valhalla engine is NOT included in this repository. Point these variables
# to your Valhalla-main installation. These are required for certain features
# (identity patch export, bridge operations) but not for basic pipeline runs.

# Path to Valhalla-main repository root
# VAL_VALHALLA_ROOT=C:\Ai\Valhalla-main

# Or configure individual executables/scripts (overrides VAL_VALHALLA_ROOT):
# VAL_VALHALLA_EXE=C:\Ai\Valhalla-main\target\release\valhalla_base.exe
# VAL_VALHALLA_EXPORT_EXE=C:\Ai\Valhalla-main\target\release\valhalla_model_export.exe
# VAL_VALHALLA_ENCODE=C:\Ai\Valhalla-main\tools\valhalla_dl_front\encode.py
# VAL_VALHALLA_QWEN_MODEL=C:\Ai\models\Qwen2.5-3B-Instruct

# ============================================================================
# Model-Specific Paths
# ============================================================================
# Override individual model locations if not under VAL_MODELS_ROOT:
# VAL_YUNET_MODEL=C:\Ai\models\yunet\face_detection_yunet_2023mar.onnx
# VAL_IP_ADAPTER_ROOT=C:\Ai\models\ip-adapter

# ============================================================================
# Service Configuration
# ============================================================================
FATE_TAU=0.5
FATE_HOST=127.0.0.1
FATE_PORT=8790
# FATE_API_KEY=change-me   # if set, /v1 requires header X-API-Key

# ============================================================================
# Output and Data Directories
# ============================================================================
# VAL_PIPELINE_OUT=D:\runs\pipeline
# VAL_CHARACTERS_DIR=./characters  # Character definition files

# ============================================================================
# Windows Owner's Quick Start (Reference Machine)
# ============================================================================
# If you're the project owner on the Windows + RTX 4090 machine:
# 1. Set VAL_VALHALLA_ROOT to your Valhalla-main installation
# 2. VAL_MODELS_ROOT should point to your existing C:\Ai\models
# 3. Everything else can use defaults
#
# Example .env file:
#   VAL_MODELS_ROOT=C:\Ai\models
#   VAL_VALHALLA_ROOT=C:\Ai\Valhalla-main
#   FATE_API_KEY=your-secret-key-here
#
# Then run: .\install.ps1 && cd code && ..\.venv\Scripts\python doctor.py
